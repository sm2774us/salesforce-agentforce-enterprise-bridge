# Copy to .env (git-ignored). In CI use GitHub Environment secrets instead.
# My Domain URL is REQUIRED for the client-credentials flow (no trailing slash).
SF_LOGIN_URL=https://YOURDOMAIN.develop.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=62.0
# Optional: enables the LLM planner (falls back to rules on any failure).
ANTHROPIC_API_KEY=
BRIDGE_LLM_MODEL=claude-sonnet-5-5
# Format: key=name:ROLE,... ; roles: VIEWER, AGENT, APPROVER, ADMIN. Generate keys: openssl rand -hex 24
BRIDGE_API_KEYS=agent-key-CHANGE-ME=agent-svc:AGENT,approver-key-CHANGE-ME=jane:APPROVER
BRIDGE_FINANCIAL_THRESHOLD_USD=10000
